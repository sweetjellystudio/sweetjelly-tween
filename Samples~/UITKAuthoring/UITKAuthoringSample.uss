.sample-panel { width: 100%; height: 100%; }
.sample { flex-grow: 1; background-color: #111c2a; padding: 24px; }
.sample-heading { font-size: 28px; color: #f6eddf; margin-bottom: 20px; }
.copies { flex-direction: row; flex-grow: 1; }
.copy { flex-grow: 1; flex-basis: 0; margin-right: 16px; }
.copy-template { flex-grow: 1; }
.copy-controls { flex-direction: row; flex-wrap: wrap; margin-top: 12px; }
.copy-controls Button { min-width: 64px; height: 30px; margin-right: 5px; background-color: #38546b; color: #f6eddf; border-radius: 4px; -unity-text-align: middle-center; }
.copy-controls Button:hover { background-color: #4b6f89; }
.copy Slider { min-height: 28px; flex-direction: row; align-items: center; margin-top: 8px; }
.copy Slider > Label { min-width: 44px; color: #c6d1df; }
.copy Slider .unity-base-field__input { flex-grow: 1; min-height: 20px; }
.copy .unity-base-slider__drag-container { flex-grow: 1; min-height: 20px; }
.copy .unity-base-slider__tracker { position: absolute; left: 0; right: 0; top: 9px; height: 3px; background-color: #8099ae; }
.copy .unity-base-slider__dragger { position: absolute; top: 4px; width: 13px; height: 13px; border-radius: 7px; background-color: #dc7995; }
.copy .unity-base-slider__dragger-border { display: none; }
.sample-status { margin-top: 16px; color: #c6d1df; white-space: normal; }
